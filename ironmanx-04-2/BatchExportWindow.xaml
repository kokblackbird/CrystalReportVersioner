<Window x:Class="ironmanx_04_2.BatchExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Export Formulas / AI Summaries" Height="640" Width="820"
        WindowStartupLocation="CenterOwner" Background="#0D1B22">
    <Window.Resources>
        <SolidColorBrush x:Key="BrushSurface" Color="#FF122733"/>
        <SolidColorBrush x:Key="BrushBorderDark" Color="#FF1F3A46"/>
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#FFE6F9FF"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="#FFA5C7D1"/>
        <SolidColorBrush x:Key="BrushCyan" Color="#FF00E5FF"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDark}"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushCyan}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="Margin" Value="0,0,16,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushCyan}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Report folder:"/>
        <TextBox x:Name="FolderText" Grid.Row="0" Grid.Column="1"/>
        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
            <Button Content="Browse..." Margin="6,0,0,6" Click="BrowseFolder_Click"/>
            <CheckBox x:Name="RecursiveCheck" Content="Subfolders" IsChecked="True" Margin="8,4,0,6"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Report paths:" VerticalAlignment="Top" Margin="0,4,8,6"/>
        <TextBox x:Name="PathsText" Grid.Row="1" Grid.Column="1" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 ToolTip="Comma-delimited .rpt files or folders, e.g. C:\Reports\A.rpt, C:\Reports\B.rpt, \\server\share\more"/>
        <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Top">
            <Button Content="Add files..." Margin="6,0,0,6" Click="AddFiles_Click"/>
            <Button Content="Preview list" Margin="6,0,0,6" Click="Preview_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Output folder:"/>
        <TextBox x:Name="OutputText" Grid.Row="2" Grid.Column="1"/>
        <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Margin="6,0,0,6" HorizontalAlignment="Left" Click="BrowseOutput_Click"/>

        <TextBlock Grid.Row="3" Text="Options:"/>
        <WrapPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
            <CheckBox x:Name="SpecCheck" Content="Full spec (REPORT_SPEC.md + JSON)" IsChecked="True"/>
            <CheckBox x:Name="AiCheck" Content="AI summary per report" IsChecked="True"/>
            <CheckBox x:Name="ZipCheck" Content="Zip output" IsChecked="True"/>
        </WrapPanel>

        <TextBlock Grid.Row="4" Text="AI instructions:"/>
        <TextBox x:Name="InstructionsText" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                 ToolTip="Optional extra guidance for the AI summaries, e.g. 'focus on business rules and C# conversion difficulty'"/>

        <TextBlock Grid.Row="5" Grid.ColumnSpan="3" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"
                   Text="Each report gets a copy of its .rpt, formulas.md (all formulas + selection), optionally REPORT_SPEC.md / report-spec.json and summary.md. An INDEX.md lists every report. Only report structure is sent to the AI - no row data."/>

        <Grid Grid.Row="6" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ListCountText" Text="Reports (click Preview list, untick to skip):"/>
                <Button Content="All" Margin="4,0,0,6" Click="SelectAll_Click"/>
                <Button Content="None" Margin="4,0,0,6" Click="SelectNone_Click"/>
            </StackPanel>
            <ListBox x:Name="ReportList" Grid.Row="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorderDark}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Path}" ToolTip="{Binding Path}" Margin="0,0,0,2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Column="2" Text="Log:"/>
            <TextBox x:Name="LogText" Grid.Row="1" Grid.Column="2" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0"/>
        </Grid>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,16,0"/>
            <Button x:Name="StopButton" Content="Stop" Width="90" Margin="0,0,8,0" IsEnabled="False" Click="Stop_Click"/>
            <Button x:Name="RunButton" Content="Export" Width="110" Margin="0,0,8,0" Click="Run_Click"/>
            <Button Content="Close" Width="90" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
