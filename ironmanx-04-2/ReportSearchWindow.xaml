<Window x:Class="ironmanx_04_2.ReportSearchWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="AI Report Search" Height="700" Width="900"
		WindowStartupLocation="CenterOwner" Background="#0D1B22">
	<Window.Resources>
		<SolidColorBrush x:Key="BrushSurface" Color="#FF122733"/>
		<SolidColorBrush x:Key="BrushBorderDark" Color="#FF1F3A46"/>
		<SolidColorBrush x:Key="BrushTextPrimary" Color="#FFE6F9FF"/>
		<SolidColorBrush x:Key="BrushTextMuted" Color="#FFA5C7D1"/>
		<SolidColorBrush x:Key="BrushCyan" Color="#FF00E5FF"/>
		<Style TargetType="TextBlock">
			<Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,0,8,6"/>
		</Style>
		<Style TargetType="TextBox">
			<Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
			<Setter Property="Background" Value="{StaticResource BrushSurface}"/>
			<Setter Property="BorderBrush" Value="{StaticResource BrushBorderDark}"/>
			<Setter Property="CaretBrush" Value="{StaticResource BrushCyan}"/>
			<Setter Property="Padding" Value="4,3"/>
			<Setter Property="Margin" Value="0,0,0,6"/>
		</Style>
		<Style TargetType="CheckBox">
			<Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
			<Setter Property="Margin" Value="0,0,16,6"/>
		</Style>
		<Style TargetType="Button">
			<Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
			<Setter Property="Background" Value="{StaticResource BrushSurface}"/>
			<Setter Property="BorderBrush" Value="{StaticResource BrushCyan}"/>
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="Margin" Value="0,0,0,6"/>
		</Style>
	</Window.Resources>
	<Grid Margin="12">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="130"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="Search folder:"/>
		<TextBox x:Name="FolderText" Grid.Row="0" Grid.Column="1"/>
		<StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
			<Button Content="Browse..." Margin="6,0,0,6" Click="BrowseFolder_Click"/>
			<CheckBox x:Name="RecursiveCheck" Content="Subfolders" IsChecked="True" Margin="8,4,0,6"/>
		</StackPanel>

		<TextBlock Grid.Row="1" Text="Looking for:"/>
		<TextBox x:Name="QueryText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
				 ToolTip="Describe the report, e.g. 'monthly sales by customer with returns' or 'invoice aging'"/>

		<TextBlock Grid.Row="2" Text="Output folder:"/>
		<TextBox x:Name="OutputText" Grid.Row="2" Grid.Column="1"/>
		<Button Grid.Row="2" Grid.Column="2" Content="Browse..." Margin="6,0,0,6" HorizontalAlignment="Left" Click="BrowseOutput_Click"/>

		<TextBlock Grid.Row="3" Text="Options:"/>
		<WrapPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
			<CheckBox x:Name="AiCheck" Content="AI summaries &amp; explanations" IsChecked="True"/>
			<CheckBox x:Name="CopyCheck" Content="Copy results to output folder" IsChecked="True"/>
			<CheckBox x:Name="LearnAiCheck" Content="AI summaries in Learning mode (slower, uses tokens)" IsChecked="False"/>
		</WrapPanel>

		<TextBlock x:Name="IndexInfoText" Grid.Row="4" Grid.ColumnSpan="3" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>

		<Grid Grid.Row="5" Grid.ColumnSpan="3">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="2*"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<TextBlock Text="Results (double-click to open the original location):"/>
			<ListBox x:Name="ResultList" Grid.Row="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorderDark}"
					 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ResultList_MouseDoubleClick">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Margin="0,0,0,8">
							<TextBlock Text="{Binding Header}" Foreground="#FF00E5FF" FontWeight="Bold" Margin="0"/>
							<TextBlock Text="{Binding Path}" Foreground="#FFA5C7D1" Margin="0" TextWrapping="Wrap"/>
							<TextBlock Text="{Binding Explanation}" Margin="0,2,0,0" TextWrapping="Wrap"/>
							<TextBlock Text="{Binding Summary}" Margin="0,2,0,0" TextWrapping="Wrap" Opacity="0.85"/>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<TextBlock Grid.Row="2" Text="Log:" Margin="0,6,8,6"/>
			<TextBox x:Name="LogText" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
					 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0"/>
		</Grid>

		<StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
			<TextBlock x:Name="StatusText" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,16,0"/>
			<Button Content="Open index" Width="100" Margin="0,0,8,0" Click="OpenIndex_Click"/>
			<Button x:Name="LearnButton" Content="Learning mode" Width="120" Margin="0,0,8,0" Click="Learn_Click"
					ToolTip="Scan every report in the folder into the master index so future searches are faster and smarter."/>
			<Button x:Name="StopButton" Content="Stop" Width="90" Margin="0,0,8,0" IsEnabled="False" Click="Stop_Click"/>
			<Button x:Name="SearchButton" Content="Search" Width="110" Margin="0,0,8,0" IsDefault="True" Click="Search_Click"/>
			<Button Content="Close" Width="90" Click="Close_Click"/>
		</StackPanel>
	</Grid>
</Window>
